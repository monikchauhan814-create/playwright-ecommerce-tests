    {
      "name": "https://httpbin.org/anything",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Request was sent as XML\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.headers[\"Content-Type\"]).to.include(\"application/xml\");",
              "});",
              "",
              "pm.test(\"XML customer data was received\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.data).to.include(\"<id>101</id>\");",
              "    pm.expect(response.data).to.include(\"<email>testuser@example.com</email>\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
